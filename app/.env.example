# Firebase Web 앱 config — Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) 에서 복사.
# Expo SDK 54는 EXPO_PUBLIC_ 접두사 변수를 빌드 타임에 인라인함.
# 이 값들은 비밀이 아님(클라이언트 노출 정상). 실제 보안은 Firestore 보안 규칙으로 한다.
#
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값으로 채울 것.
#   cp .env.example .env

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
