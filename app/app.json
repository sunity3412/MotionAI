{
  "expo": {
    "name": "Sunity AI Coach",
    "slug": "sunity-ai-coach",
    "scheme": "sunityaicoach",
    "version": "1.2.2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.sunity.aicoach",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.sunity.aicoach",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "연습 영상을 선택해 AI 자세 분석에 사용하기 위해 사진 보관함 접근이 필요합니다.",
          "cameraPermission": "연습 자세를 촬영해 AI 자세 분석에 사용하기 위해 카메라 접근이 필요합니다.",
          "microphonePermission": "영상 촬영 시 소리를 함께 녹화하기 위해 마이크 접근이 필요합니다."
        }
      ],
      "expo-video",
      "expo-asset",
      "expo-mail-composer",
      "expo-screen-orientation",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.965554697584-jp90s17qk6tuqf17ucgj41h83bvg4jn2"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d2872ef6-c8be-467f-8fd8-d2cd8a8d4bb2"
      }
    },
    "owner": "sunity3412",
    "updates": {
      "url": "https://u.expo.dev/d2872ef6-c8be-467f-8fd8-d2cd8a8d4bb2"
    }
  }
}
